# Use full Python image to avoid compilation issues
FROM python:3.11

# Prevent Python from buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Upgrade pip and packaging tools
RUN pip install --upgrade pip setuptools wheel

# Copy requirements first (Docker layer caching)
COPY backend/requirements.txt ./requirements.txt

# Install Python dependencies (prebuilt wheels)
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ ./backend/

EXPOSE 10000

# Start FastAPI using Render's dynamic PORT environment variable
CMD ["sh", "-c", "uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-10000}"]
